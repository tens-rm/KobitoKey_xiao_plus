#include <input/processors.dtsi>
#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /*
     * ジェスチャーパッド。
     *
     * gesture_left / gesture_right の中に zone1, zone2, ... と書いた数が、
     * そのままパッドの分割数になる(1〜5)。zone1 が一番上で、下へ順に並べる。
     * 解除の長押しをした位置のゾーンが、解除後に使われる。
     *
     * 各ゾーンの書き方:
     *
     *   zoneN {
     *       mode = "step";                          // 省略すると "step"
     *       bindings = <上げ 下げ ダブルタップ>;   // ちょうど3つ。使わないものは &none
     *       led-color = <3>;                        // 省略すると上から緑・黄・赤・マゼンタ・青
     *   };
     *
     * mode = "scroll" のゾーンは、マウスのホイールを直接動かすので、bindings を
     * 書かなくてよい(書けば、3つ目がダブルタップになる)。
     *
     * mode:
     *   "step"       なぞった量だけ、目盛りごとに連続して出す(音量など)。
     *                はじいても何も足さない
     *   "flick"      1回のスワイプで1回だけ出す(曲送りなど)
     *   "step-flip"  "step" と同じ動きに、はじいて離したとき一気に数段足す動きを
     *                加える。はじきの有無だけが "step" との違い
     *   "scroll"     なぞった量だけ、マウスのホイールを直接動かす
     *   "tap"        このゾーンで解除すると、パッド全体が選択肢の数に分かれ、長押しして
     *                振動が入ったとき、触れた場所の選択肢(bindings が上から順)を入力する
     *                (ダブルタップで double-bindings)
     *   "cycle"      選択肢をフリックで順に切り替える(上へ=次、下へ=前)。ダブルタップで
     *                反対側(double-bindings)と元を行き来する
     *
     * 「上げ」は、パッドを物理的に上へなぞった向き(右手・左手とも同じ)。
     * led-color は bit0 赤, bit1 緑, bit2 青(1=赤 2=緑 3=黄 4=青 5=マゼンタ 6=水色 7=白)。
     */
    gesture_left: gesture_left {
        compatible = "kobitokey,gesture-zones";

        zone1 {
            /* 輝度 */
            mode = "step";
            bindings = <&kp C_BRI_UP &kp C_BRI_DN &none>;
        };
        zone2 {
            /* 音量(ダブルタップでミュート) */
            mode = "step";
            bindings = <&kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE>;
        };
    };

    gesture_right: gesture_right {
        compatible = "kobitokey,gesture-zones";

        zone1 {
            /*
             * Rhino のビューポートのタブ(画面右下の Perspective / Top / Front / Right)の
             * 切り替え。このゾーンで解除したあと、フリックで順に切り替える
             * (上へ=次、下へ=前。Perspective → Top → Front → Right → Perspective)。
             * ダブルタップは使わない(反対側のビューはタブにないため)。
             *
             * 送るのは Ctrl+Command+1〜4(Rhino 側の内部名は MacControlCommand1〜4)。
             * Rhino 側に、このキーのショートカットを登録しておく必要がある
             * (rhino_set_view_shortcuts.py を Rhino で1回実行する)。
             *   1 Perspective / 2 Top / 3 Front / 4 Right
             */
            mode = "cycle";
            bindings = <&kp LC(LG(N1)) &kp LC(LG(N2)) &kp LC(LG(N3)) &kp LC(LG(N4))>;
        };
        zone2 {
            /*
             * 選択肢(Claude Code デスクトップアプリの承認)。このゾーンで解除すると、
             * パッド全体が3つに分かれ(上から 1, 2, 3)、選びたい場所を長押しして
             * 振動が入ったとき、そのキーが入力される(入力しても、ロックは続く)。
             *   上 1(拒否)
             *   中 2(常に許可)
             *   下 3(一度だけ許可)
             * ⌘Enter / ⌘Shift+Enter は、画面によって意味が変わる・効かないので、番号キーにした。
             */
            mode = "tap";
            bindings = <&kp N1 &kp N2 &kp N3>;
        };
        zone3 {
            /* 曲送り(1回のスワイプで1曲、ダブルタップで再生/停止) */
            mode = "flick";
            bindings = <&kp C_NEXT &kp C_PREV &kp C_PP>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LCMD>, <&to 0>;
        };

        lt2_space_repeat: lt2_space_repeat {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };


        
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                       &kp T                 &kp Y    &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                       &kp G                 &kp H    &kp J  &kp K      &kp L    &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                       &kp B                 &kp N    &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 3 INT_HENKAN &mt LEFT_SHIFT SPACE  &mo 5    &lt 2 ENTER  &lt 2 ENTER  &kp RSHFT  &k PRINTSCREEN
            >;
        };

        layer1 {
            label = "NUM_SYM";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6          &kp NUMBER_7      &kp NUMBER_8       &kp NUMBER_9  &kp NUMBER_0
&kp LC(A)     &kp LC(S)     &kp LC(D)     &kp LC(F)     &kp LANG2      &kp GRAVE             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS     &kp EQUAL
&kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LANG1      &kp NON_US_BACKSLASH  &kp SQT           &kp COMMA          &kp PERIOD    &kp SLASH
&trans        &trans        &trans        &trans        &trans         &trans                &trans            &trans             &trans        &trans
            >;
        };

        layer2 {
            label = "SYM";
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)       &kp LS(NUMBER_6)          &kp LS(NUMBER_7)      &kp LS(NUMBER_8)       &kp LS(NUMBER_9)  &kp LS(NUMBER_0)
&kp TAB           &none             &kp KP_NUMBER_5   &kp BACKSPACE     &kp LANG2              &kp LS(GRAVE)             &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp LS(MINUS)     &kp LS(EQUAL)
&kp ESCAPE        &none             &kp KP_NUMBER_2   &kp DELETE        &kp LANG1              &kp LS(NON_US_BACKSLASH)  &kp LS(SQT)           &kp LS(COMMA)          &kp LS(PERIOD)    &kp LS(SLASH)
&trans            &trans            &trans            &trans            &trans                 &trans                    &trans                &trans                 &trans            &trans
            >;
        };

        layer3 {
            label = "FUNC";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5      &kp F6  &kp F7  &kp F8  &kp F9 &kp F10
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans &kp F11
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans &trans
            >;
        };

        layer4 {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans      &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans    &trans
            >;
        };

        layer5 {
            label = "ARROW";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans  &trans          &kp UP_ARROW     &trans           &trans
&trans  &trans  &trans  &trans  &trans      &trans  &kp LEFT_ARROW  &kp DOWN         &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans           &trans           &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans           &trans           &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans             &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans             &bootloader   &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans             &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };
    };
};
